# Copy to `.env` and fill in the password you chose when installing PostgreSQL.
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore and must never be committed. Every script in
# this module reads its connection from here via db_config.py, so this is the
# only place the credential lives.

PGHOST=localhost
PGPORT=5432
PGDATABASE=gradcafe
PGUSER=postgres
PGPASSWORD=replace-me

# Alternatively, set one full URL instead of the five variables above and
# db_config.database_url() will use it verbatim:
# DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/gradcafe
