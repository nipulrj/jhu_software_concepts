# Database credentials. `.env.example` is committed; the real `.env` never is.
.env

# Working files written by a Pull Data run: large, regenerable, not deliverables.
data/

# Downloaded GGUF model weights (~670 MB), fetched on first run of the LLM
# stage from Hugging Face.
llm_hosting/models/

# Cached raw model answers. Regenerable, and only an optimization: it lets a
# rerun skip the model for strings already standardized.
llm_hosting/standardization_cache.json

# Marker file written while a Pull Data scrape is in flight.
.pull_data.lock

# Test and coverage artifacts. coverage_summary.txt IS committed -- it is the
# deliverable -- but the machine-readable data behind it is not.
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Sphinx scratch space. docs/_build/html IS committed -- the generated site is
# one of the deliverables -- but the doctree cache behind it is not. Build with
# `make -C docs html`, or `python -m sphinx -b html -d docs/_build/doctrees
# docs docs/_build/html`, so the cache lands outside the published tree.
docs/_build/doctrees/
docs/_build/html/.doctrees/
