# Copy to `.env` and fill in the password you chose when installing PostgreSQL.
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore and must never be committed. Every module here
# reads its connection through db_config.py, so this is the only place the
# credential lives.

# --- the application database --------------------------------------------
# One full libpq URL is the preferred form and the one the tests and the CI
# workflow set.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/gradcafe

# Alternatively, leave DATABASE_URL unset and give the five standard libpq
# variables instead; db_config.py understands either form.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=gradcafe
# PGUSER=postgres
# PGPASSWORD=replace-me

# --- the database the test suite uses ------------------------------------
# The `db` and `integration` tests create, truncate and drop tables, so they
# refuse to run against the application database unless it is the one named
# here. Point this at a scratch database -- `createdb gradcafe_test` -- so a
# test run can never touch real rows.
TEST_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/gradcafe_test

# --- Flask ---------------------------------------------------------------
# Signs the flash-message cookie. Any long random string; omit it and the app
# generates a fresh one at start-up instead of committing a constant.
# FLASK_SECRET_KEY=
